<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Базовый фон -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2125"/>
        </shape>
    </item>

    <!-- Правый верхний фиолетовый градиент -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.1"
                android:gradientRadius="600dp"
                android:startColor="#CC5A01FF"
                android:endColor="#005A01FF"/>
        </shape>
    </item>

    <!-- Левый градиент -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.4"
                android:gradientRadius="500dp"
                android:startColor="#CCAF01FF"
                android:endColor="#00AF01FF"/>
        </shape>
    </item>

</layer-list>